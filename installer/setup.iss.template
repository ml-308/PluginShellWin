; PluginShellWin native installer (Inno Setup 6).
; TEMPLATE: installer/build_installer.py substitutes @@SRC@@ / @@OUT@@ /
; @@SAMPLE_FILES@@ before invoking ISCC.exe.
; All strings here are ASCII so the script compiles on any system codepage;
; Chinese docs are shipped as plain data files.

#define AppName "PluginShellWin"
#define AppVersion "1.0.0"
#define AppPublisher "ml-308"
#define Src "@@SRC@@"
#define Out "@@OUT@@"

[Setup]
AppId={{5C2A9E14-7B3D-4A81-9F62-1D8E4C7B3A55}
AppName={#AppName}
AppVersion={#AppVersion}
AppPublisher={#AppPublisher}
DefaultDirName={localappdata}\{#AppName}
DefaultGroupName={#AppName}
; 让用户能改安装位置，「准备安装」页复查所选路径
DisableDirPage=no
UsePreviousAppDir=yes
AlwaysShowDirOnReadyPage=yes
DirExistsWarning=auto
; 快捷方式用显式复选框控制，不另开「开始菜单文件夹」页
DisableProgramGroupPage=yes
AllowNoIcons=yes
LicenseFile={#Src}\LICENSE
InfoBeforeFile={#Src}\installer\staging\INFO.txt
OutputDir={#Out}
OutputBaseFilename=setup
SetupIconFile={#Src}\assets\app.ico
Compression=lzma2/max
SolidCompression=yes
WizardStyle=modern
PrivilegesRequired=lowest
PrivilegesRequiredOverridesAllowed=dialog
UninstallDisplayName={#AppName} {#AppVersion}
UninstallDisplayIcon={app}\{#AppName}.exe
CloseApplications=yes
RestartApplications=no
RestartIfNeededByRun=no
VersionInfoVersion=1.0.0.0
VersionInfoCompany={#AppPublisher}
VersionInfoProductName={#AppName}
VersionInfoDescription=C# native plugin host with Python plugin runtime
OutputManifestFile={#Out}\setup-manifest.txt

[Languages]
Name: "english"; MessagesFile: "compiler:Default.isl"

[Tasks]
Name: "desktopicon"; Description: "Create a desktop shortcut"; GroupDescription: "Shortcuts (both checked by default):"
Name: "startmenuicon"; Description: "Create a Start Menu shortcut"; GroupDescription: "Shortcuts (both checked by default):"
Name: "sampleplugins"; Description: "Install sample plugins (lesson / tool / lab)"; GroupDescription: "Optional content:"; Flags: unchecked

[Dirs]
; 即使不装示例插件，也要有一个空插件目录，首次启动才是「空壳」而不是报错
Name: "{app}\plugins"

[Files]
Source: "{#Src}\dist\app\{#AppName}.exe"; DestDir: "{app}"
Source: "{#Src}\runtime\dist\PluginRuntime.exe"; DestDir: "{app}\runtime"
Source: "{#Src}\src\PluginShellWin.App\config\appsettings.json"; DestDir: "{app}\config"
Source: "{#Src}\plugins\README.md"; DestDir: "{app}\plugins"
Source: "{#Src}\README.md"; DestDir: "{app}"
Source: "{#Src}\LICENSE"; DestDir: "{app}"
Source: "{#Src}\installer\staging\INSTALL-CN.txt"; DestDir: "{app}"
@@SAMPLE_FILES@@

[Icons]
Name: "{autoprograms}\{#AppName}"; Filename: "{app}\{#AppName}.exe"; WorkingDir: "{app}"; Tasks: startmenuicon
Name: "{autodesktop}\{#AppName}"; Filename: "{app}\{#AppName}.exe"; WorkingDir: "{app}"; Tasks: desktopicon

[Run]
Filename: "{app}\{#AppName}.exe"; Description: "Launch {#AppName}"; Flags: postinstall nowait skipifsilent unchecked
